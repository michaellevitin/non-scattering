Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bdry004", "[", "t_", "]"}], ":=", 
   RowBox[{"1", "+", 
    RowBox[{
     RowBox[{"br004", "[", 
      RowBox[{"[", "1", "]"}], "]"}], 
     RowBox[{"Cos", "[", 
      RowBox[{"2", "t"}], "]"}]}], "+", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"br004", "[", 
        RowBox[{"[", "j", "]"}], "]"}], 
       RowBox[{"Cos", "[", 
        RowBox[{"2", "j", " ", "t"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2", ",", "24"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ell", "[", 
    RowBox[{"a_", ",", "b_", ",", "t_"}], "]"}], ":=", 
   RowBox[{"a", " ", 
    RowBox[{"b", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"b", "^", "2"}], 
        RowBox[{
         RowBox[{"Cos", "[", "t", "]"}], "^", "2"}]}], "+", 
       RowBox[{
        RowBox[{"a", "^", "2"}], 
        RowBox[{
         RowBox[{"Sin", "[", "t", "]"}], "^", "2"}]}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalOmega]", "=", 
   RowBox[{"ParametricRegion", "[", 
    RowBox[{
     RowBox[{"r", " ", 
      RowBox[{"bdry004", "[", "t", "]"}], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
        RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
