Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"optellipse", "[", 
    RowBox[{
     RowBox[{"a_", "?", "NumericQ"}], ",", 
     RowBox[{"b_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"bdry004", "[", "t", "]"}], "-", 
        RowBox[{"ell", "[", 
         RowBox[{"a", ",", "b", ",", "t"}], "]"}]}], ")"}], "^", "2"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Trapezoidal\>\"", ",", 
        RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"min", "=", 
  RowBox[{"FindMinimum", "[", 
   RowBox[{
    RowBox[{"optellipse", "[", 
     RowBox[{"a", ",", "b"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "1.04"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", "0.96"}], "}"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"fignew2", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"bdry004", "[", "t", "]"}], "-", "1"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"bdry004", "[", "t", "]"}], "-", 
        RowBox[{"ell", "[", 
         RowBox[{"a", ",", "b", ",", "t"}], "]"}]}], "/.", 
       RowBox[{"min", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"AbsoluteThickness", "[", "3", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AbsoluteThickness", "[", "3", "]"}], ",", 
         RowBox[{"Dashing", "[", 
          RowBox[{"{", 
           RowBox[{"0.04", ",", "0.015"}], "}"}], "]"}], ",", " ", 
         "Magenta"}], "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"Ticks", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Pi", "/", "2"}], ",", " ", 
           RowBox[{"MaTeX", "[", "\"\<\\\\frac{\\\\pi}{2}\>\"", "]"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Pi", ",", " ", 
           RowBox[{"MaTeX", "[", "\"\<\\\\pi\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", 
            RowBox[{"Pi", "/", "2"}]}], ",", " ", 
           RowBox[{"MaTeX", "[", "\"\<\\\\frac{3\\\\pi}{2}\>\"", "]"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", "Pi"}], ",", " ", 
           RowBox[{"MaTeX", "[", "\"\<2\\\\pi\>\"", "]"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"y", ",", " ", 
           RowBox[{"MaTeX", "[", "y", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"y", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.04"}], ",", 
             RowBox[{"-", "0.02"}], ",", "0.02", ",", "0.04"}], "}"}]}], 
          "}"}]}], "]"}]}], "}"}]}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MaTeX", "[", "\"\<\\\\theta\>\"", "]"}], ",", "None"}], 
      "}"}]}], ",", 
    RowBox[{"AspectRatio", "->", "1"}]}], "]"}]}]}], "Input",
